            "pages": [
              "features/overview",
              "features/workflow-automation",
              "features/integrations",
              "features/collaboration"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "guides/user-management",
              "guides/project-setup",
              "guides/best-practices",
              "guides/troubleshooting"
            ]
          },
          {
            "group": "Security & Compliance",
            "pages": [
              "security/overview",
              "security/authentication",
              "security/data-protection",
              "security/compliance"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "API Documentation",
            "pages": [
              "api-reference/introduction",
              "api-reference/authentication",
              "api-reference/rate-limits"
            ]
          },
          {
            "group": "Endpoints",
            "pages": [
              "api-reference/endpoint/users",
              "api-reference/endpoint/projects",
              "api-reference/endpoint/workflows",
              "api-reference/endpoint/webhooks"
            ]
          }
        ]
      },
      {
        "tab": "Resources",
        "groups": [
          {
            "group": "Support",
            "pages": [
              "resources/support",
              "resources/community",
              "resources/changelog"
            ]
          },
          {
            "group": "Advanced",
            "pages": [
              "advanced/customization",
              "advanced/enterprise",
              "advanced/integrations"
            ]
          }
        ]

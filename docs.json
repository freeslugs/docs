    "global": {
      "anchors": [
        {
          "anchor": "Support",
          "href": "https://fellow.app/support",
          "icon": "life-ring"
        },
        {
          "anchor": "Community",
          "href": "https://community.fellow.app",
          "icon": "users"
        },
        {
          "anchor": "Status",
